(() => {
  'use strict';

  const cards = document.querySelector('#categories.cards');
  if (!cards || cards.querySelector('a[href="ocr-tap-calculator.html"]')) return;

  cards.setAttribute('aria-label', '7つの入口');

  const card = document.createElement('a');
  card.className = 'card ocr-tap-card';
  card.href = 'ocr-tap-calculator.html';
  card.innerHTML = `
    <div class="row"><span class="n">07</span><span class="ico">🧮</span></div>
    <h2>OCRタップ計算</h2>
    <p>変圧器構成・CT比からTapを計算し、レバー・瞬時まで整理する。</p>
    <div class="examples">単相/三相Tr / CT / Tap / D / 700%・1000%</div>
    <span class="go">計算する <b>→</b></span>
  `;
  cards.appendChild(card);

  if (!document.getElementById('ocr-tap-card-style')) {
    const style = document.createElement('style');
    style.id = 'ocr-tap-card-style';
    style.textContent = `
      .cards .ocr-tap-card{border-color:#2f6b7f}
      .cards .ocr-tap-card .ico,.cards .ocr-tap-card .go{color:#57bfdc}
      @media(min-width:1021px){.cards .ocr-tap-card{grid-column:2}}
      @media(max-width:1020px) and (min-width:681px){
        .cards .ocr-tap-card{grid-column:1/-1;width:calc(50% - 6px);justify-self:center}
      }
      @media(max-width:680px){
        .cards .ocr-tap-card{grid-column:1/-1;min-height:132px}
      }
    `;
    document.head.appendChild(style);
  }
})();
